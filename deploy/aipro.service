[Unit]
Description=Google AI Pro price monitor + Telegram bot
After=network-online.target
Wants=network-online.target

[Service]
User=aipro
WorkingDirectory=/opt/aipro
EnvironmentFile=/opt/aipro/.env
ExecStart=/usr/bin/python3 -m aipro run
Restart=always
RestartSec=10
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/opt/aipro/data
PrivateTmp=true

[Install]
WantedBy=multi-user.target
