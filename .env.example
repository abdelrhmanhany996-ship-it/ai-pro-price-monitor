# انسخ إلى .env (chmod 600). لا ترفع .env إلى GitHub.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=            # معرّف المحادثة المصرّح لها (رقم)

# رابط التتبع العام (HTTPS) الذي يشير إلى هذه الخدمة، بدون / في النهاية. مثال: https://track.example.com
TRACK_BASE_URL=
WEB_HOST=127.0.0.1
WEB_PORT=8080

CHECK_INTERVAL_SECONDS=300       # فحص كل موقع كل 5 دقائق
REMINDER_INTERVAL_SECONDS=3600   # تذكير كل ساعة (تتبعه رسالة بجدول الأسعار)
THRESHOLD_EGP=200                # التنبيه عندما يكون السعر أقل من هذا (صارم)
CONFIRM_CHECKS=2                 # عدد القراءات المتطابقة لتأكيد تغيّر السعر (1 = بدون تأكيد)
ERROR_ALERT_AFTER=3              # إشعار خطأ بعد N فحوصات فاشلة متتالية
MAX_STALE_SECONDS=1800           # لا تُرسل تذكيرات إذا كان آخر سعر أقدم من هذا
DAILY_REPORT_TIME=21:00
TIMEZONE=Africa/Cairo

FX_REFRESH_SECONDS=3600
FX_MAX_AGE_HOURS=48              # أقدم عمر مقبول لسعر الصرف
DB_PATH=data/aipro.db
LOG_LEVEL=INFO
